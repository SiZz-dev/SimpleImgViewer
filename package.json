{
  "name": "simpleimgviewer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-web.mjs",
    "start": "node backend/main.mjs",
    "test": "node --test \"backend/test/**/*.test.mjs\"",
    "licenses": "node scripts/audit-node-licenses.mjs",
    "modules:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-native-modules.ps1 -Download",
    "modules:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-native-modules.ps1 -VerifyOnly"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": { "vite": "8.3.8" }
}
