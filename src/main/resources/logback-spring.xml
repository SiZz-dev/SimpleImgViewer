<?xml version="1.0" encoding="UTF-8"?>
<configuration>
 <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
 <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
 <springProperty scope="context" name="AUDIT_DIRECTORY" source="logging.file.path" defaultValue="./.runtime/logs"/>
 <appender name="AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
  <file>${AUDIT_DIRECTORY}/audit.log</file>
  <encoder><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %msg%n</pattern><charset>UTF-8</charset></encoder>
  <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
   <fileNamePattern>${AUDIT_DIRECTORY}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
   <maxFileSize>10MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>1GB</totalSizeCap>
  </rollingPolicy>
 </appender>
 <logger name="imagegate.audit" level="INFO" additivity="false"><appender-ref ref="AUDIT"/></logger>
 <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
